{
  "name": "@shutovks/headroom-opencode-standalone",
  "version": "0.1.0",
  "description": "Self-contained Headroom transport for OpenCode — spawns the proxy, no `headroom wrap` needed.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./hook-shim/handler.js": "./hook-shim/handler.js"
  },
  "files": [
    "dist",
    "hook-shim"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "opencode",
    "headroom",
    "plugin",
    "compression",
    "token",
    "llm",
    "proxy"
  ],
  "license": "MIT",
  "author": "ShutovKS",
  "repository": {
    "type": "git",
    "url": "https://github.com/ShutovKS/headroom-opencode-standalone"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.17.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.17.20",
    "@types/node": "^22.10.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.21.5": true
  }
}
